# Ignore CMake build directories
build/
release/
debug/
install/

# Ignore dependencies folder
.deps/

# Ignore user-specific files from IDEs
*.user
*.suo

# Ignore Visual Studio Code specific files
.vscode/

# Ignore Qt Creator specific files
*.creator

# Ignore lock files
*.lock
*.lock.json

# Ignore macOS specific files
.DS_Store

# Ignore compiled binaries and libraries
*.dll
*.exe
*.so
*.a
*.lib
*.o
*.obj

.vs/
build_*/
setup/
.CMakeBuildNumber
cmake/.CMakeBuildNumber

# Quellordner für Grafiken; die fertigen Bilder liegen in img/
Bild/

# Lokale Zugangsdaten. Dieses Repo ist oeffentlich, hier darf nie ein Passwort
# landen: tools\publish-web.ps1 legt seine Angaben unter diesem Namen ab,
# mit DPAPI verschluesselt, lesbar nur fuer diesen Benutzer auf diesem Rechner.
*.local.xml
*.local.json
.netrc
